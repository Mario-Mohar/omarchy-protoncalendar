#!/usr/bin/env python3
import fcntl
import json
import os
import subprocess
import sys
import time

# A bar surface exists per monitor, and every one of them runs its own copy of
# the widget with its own reminder timer -- so a single reminder arrives here
# once per screen, a few milliseconds apart. The widget cannot dedupe that
# itself: each instance only knows what it fired. This file is the shared
# memory. First caller to record a reminder shows it, the rest exit quietly.
# It also covers a shell restart inside the five-minute window the widget
# fires in, where the in-memory record of what was announced is gone.
STATE_DIR = os.path.expanduser("~/.cache/omarchy/protoncalendar")
STATE_FILE = os.path.join(STATE_DIR, "notified.json")
CLAIM_SECONDS = 300


def claim(summary, body):
    """Record this reminder and report whether it is ours to show.

    Never raises: an unwritable state directory or a hand-edited file means a
    duplicate notification, which beats a reminder that never arrives.
    """
    key = summary + "\x00" + body
    now = time.time()
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        fd = os.open(STATE_FILE, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError:
        return True
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        try:
            raw = os.read(fd, 1 << 20).decode("utf-8")
            seen = json.loads(raw) if raw.strip() else {}
        except (OSError, ValueError, UnicodeDecodeError):
            seen = {}
        if not isinstance(seen, dict):
            seen = {}
        fresh = {}
        for name, stamp in seen.items():
            if isinstance(stamp, (int, float)) and 0 <= now - stamp < CLAIM_SECONDS:
                fresh[name] = stamp
        if key in fresh:
            return False
        fresh[key] = now
        data = json.dumps(fresh).encode("utf-8")
        try:
            os.lseek(fd, 0, os.SEEK_SET)
            os.write(fd, data)
            os.ftruncate(fd, len(data))
        except OSError:
            pass
        return True
    finally:
        os.close(fd)


def worker(payload):
    delay = max(0, int(payload.get("delaySeconds", 0)))
    if delay:
        time.sleep(delay)
    summary = str(payload.get("title", "Proton Calendar"))
    body = str(payload.get("body", ""))
    icon = str(payload.get("icon", ""))
    url = str(payload.get("url", ""))
    swedish = payload.get("language") == "sv"
    open_label = "Öppna i Proton" if swedish else "Open in Proton"
    snooze_5_label = "Skjut upp 5 min" if swedish else "Snooze 5 min"
    snooze_15_label = "Skjut upp 15 min" if swedish else "Snooze 15 min"
    dismiss_label = "Stäng" if swedish else "Dismiss"
    dry_run = os.environ.get("PROTONCAL_NOTIFY_DRY_RUN") == "1"
    if not dry_run and not claim(summary, body):
        return
    while True:
        command = [
            "notify-send", "--app-name=Proton Calendar", "--wait",
            "--action=default=" + open_label, "--action=snooze-5=" + snooze_5_label,
            "--action=snooze-15=" + snooze_15_label, "--action=dismiss=" + dismiss_label,
        ]
        if icon:
            command.append("--icon=" + icon)
        command.extend([summary, body])
        if dry_run:
            print(json.dumps(command, ensure_ascii=False))
            return
        result = subprocess.run(command, capture_output=True, text=True)
        action = result.stdout.strip()
        if action == "default" and url.startswith("https://"):
            subprocess.Popen(["xdg-open", url], start_new_session=True)
            return
        if action == "snooze-5":
            time.sleep(300)
            body = ("Uppskjuten 5 minuter · " if swedish else "Snoozed 5 minutes · ") + body
            continue
        if action == "snooze-15":
            time.sleep(900)
            body = ("Uppskjuten 15 minuter · " if swedish else "Snoozed 15 minutes · ") + body
            continue
        return


def main():
    raw = sys.stdin.readline()
    if "--worker" in sys.argv:
        worker(json.loads(raw))
        return
    process = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--worker"],
        stdin=subprocess.PIPE, start_new_session=True,
    )
    process.stdin.write(raw.encode("utf-8"))
    process.stdin.close()


if __name__ == "__main__":
    main()
